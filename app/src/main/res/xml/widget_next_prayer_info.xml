<?xml version="1.0" encoding="utf-8"?>
<!-- Didaftarkan di AndroidManifest lewat <receiver> NextPrayerWidgetProvider + <meta-data android:name="android.appwidget.provider">.
     updatePeriodMillis 0: widget diperbarui manual dari kode (setiap kali alarm adzan bunyi), bukan oleh sistem. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_next_prayer"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:previewLayout="@layout/widget_next_prayer"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
