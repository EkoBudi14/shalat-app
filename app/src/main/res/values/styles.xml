<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base style kosong: induk implisit untuk gaya WaktuShalat.* (dot-notation) -->
    <style name="WaktuShalat" />

    <!-- Tombol utama: bulat penuh (Material 3), tinggi minimal 48dp -->
    <style name="Widget.WaktuShalat.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WaktuShalat.TitleMedium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.WaktuShalat.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WaktuShalat.TitleMedium</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">?attr/colorPrimary</item>
    </style>

    <style name="Widget.WaktuShalat.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WaktuShalat.TitleMedium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Tombol utama gelap di layar izin ("Mulai") -->
    <style name="Widget.WaktuShalat.Button.Dark" parent="Widget.WaktuShalat.Button">
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <!-- Tombol ikon bulat 44dp dengan garis tepi (perbarui lokasi, bulan sebelumnya/berikutnya) -->
    <style name="Widget.WaktuShalat.IconButton.Outlined" parent="Widget.Material3.Button.IconButton.Outlined">
        <item name="android:minWidth">44dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="Widget.WaktuShalat.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.WaktuShalat.BottomNav.ActiveIndicator
        </item>
        <item name="itemIconTint">@color/selector_nav_item</item>
        <item name="itemTextColor">@color/selector_nav_item</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <!-- Switch pengaturan: track hijau saat aktif, abu saat mati -->
    <style name="Widget.WaktuShalat.Switch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/selector_switch_thumb</item>
        <item name="trackTint">@color/selector_switch_track</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>

    <style name="Widget.WaktuShalat.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
    </style>

    <!-- Baris pengaturan -->
    <style name="WaktuShalat.SettingRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">60dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="WaktuShalat.SettingTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">@style/TextAppearance.WaktuShalat.BodyLarge</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="WaktuShalat.SettingSummary" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WaktuShalat.BodyMedium</item>
    </style>

    <style name="WaktuShalat.SettingValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textAppearance">@style/TextAppearance.WaktuShalat.BodyMedium</item>
        <item name="android:textStyle">bold</item>
        <item name="drawableEndCompat">@drawable/ic_chevron_right</item>
        <item name="drawableTint">@color/ink_disabled</item>
    </style>

    <style name="WaktuShalat.SettingDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="WaktuShalat.SectionLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">4dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.WaktuShalat.LabelMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Sel tabel jadwal bulanan -->
    <style name="WaktuShalat.ScheduleCell" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:textColor">@color/selector_schedule_text</item>
        <item name="android:duplicateParentState">true</item>
    </style>

    <style name="WaktuShalat.ScheduleHeaderCell" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
</resources>
