<?xml version="1.0" encoding="utf-8"?>
<!-- Butuh 2 file TTF di folder res/font yang sama (lihat README langkah 2):
     plus_jakarta_sans_regular.ttf dan plus_jakarta_sans_bold.ttf -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/plus_jakarta_sans_regular"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/plus_jakarta_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/plus_jakarta_sans_bold"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/plus_jakarta_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
