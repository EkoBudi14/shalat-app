<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="16dp"
    android:id="@+id/widgetRoot">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWidgetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink_secondary"
                android:textSize="12sp"
                tools:text="Berikutnya · Jakarta Pusat" />

            <TextView
                android:id="@+id/tvWidgetNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/green_700"
                android:textSize="24sp"
                android:textStyle="bold"
                tools:text="Dzuhur 11:42" />
        </LinearLayout>
    </LinearLayout>

    <!-- Catatan: jangan tampilkan "1 jam 24 mnt lagi" sebagai teks biasa.
         Widget tidak diperbarui tiap menit, jadi teks relatif akan basi. Cukup jam absolut. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/cellFajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvWidgetFajrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_fajr"
                android:textColor="@color/ink_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvWidgetFajrTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="04:19" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cellDhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvWidgetDhuhrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_dhuhr"
                android:textColor="@color/ink_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvWidgetDhuhrTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="11:42" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cellAsr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvWidgetAsrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_asr"
                android:textColor="@color/ink_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvWidgetAsrTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="14:44" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cellMaghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvWidgetMaghribName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_maghrib"
                android:textColor="@color/ink_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvWidgetMaghribTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="17:48" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/cellIsha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_widget_cell"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/tvWidgetIshaName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/prayer_isha"
                android:textColor="@color/ink_secondary"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/tvWidgetIshaTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="18:58" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>