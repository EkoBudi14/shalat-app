<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="?android:colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <!--    header    -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLocationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:text="Jakarta Pusat"
                    android:gravity="center_vertical"
                    app:drawableStartCompat="@drawable/ic_location"
                    app:drawableTint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/tvDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jumat, 9 Oktober 2026 · 27 Rabiul Akhir 1448 H"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />


            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:layout_width="44dp"
                android:layout_height="44dp"
                style="@style/Widget.WaktuShalat.IconButton.Outlined"
                android:contentDescription="@string/cd_refresh_location"
                app:icon="@drawable/ic_my_location" />

        </LinearLayout>

        <!--    Card jadwal hari ini    -->

        <LinearLayout
            android:id="@+id/cardNextPrayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_hero"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingVertical="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_next"
                    android:textColor="@color/green_on_dark"
                    android:textAppearance="?attr/textAppearanceLabelMedium" />

                <TextView
                    android:id="@+id/tvNextArabic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.WaktuShalat.Arabic"
                    android:textColor="@color/green_on_dark"
                    tools:text="الظهر" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvNextName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dzuhur"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:textColor="@color/white" />

                    <TextView
                        android:id="@+id/tvCountDown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 jam 24 menit lagi"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/green_countdown"
                        android:textAppearance="?attr/textAppearanceBodyLarge" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvNextTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11:42"
                    android:textColor="@color/white"
                    android:textAppearance="?attr/textAppearanceDisplayMedium" />

            </LinearLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressNextPrayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:max="100"
                app:indicatorColor="@color/warm_accent"
                app:trackColor="@color/green_track"
                app:trackCornerRadius="3dp"
                app:trackThickness="6dp"
                android:progress="77">

            </com.google.android.material.progressindicator.LinearProgressIndicator>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/progressStart"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/green_on_dark"
                    android:fontFeatureSettings="tnum"
                    android:text="Terbit 05:33"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvProgressEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:text="Dzuhur 11:42"
                    android:textColor="@color/green_on_dark"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>




    </LinearLayout>


</androidx.core.widget.NestedScrollView>