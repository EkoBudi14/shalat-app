<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="20dp"
    android:paddingBottom="12dp"
    android:theme="@style/Theme.WaktuShalat">
    <!--  Bulan + navigasi  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrevMonth"
            style="@style/Widget.WaktuShalat.IconButton.Outlined"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/cd_prev_month"
            app:icon="@drawable/ic_chevron_left" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMonth"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                tools:text="Oktober 2026" />

            <TextView
                android:id="@+id/tvHijriRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:text="Rabiul Akhir – Jumadil Awal 1448 H" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNextMonth"
            style="@style/Widget.WaktuShalat.IconButton.Outlined"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/cd_next_month"
            app:icon="@drawable/ic_chevron_right" />
    </LinearLayout>
    <!--  Kota + metode, link ke Pengaturan  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvScheduleInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Jakarta Pusat · Kemenag 20°/18° · ihtiyat +2 menit" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangeSettings"
            style="@style/Widget.WaktuShalat.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_change" />
    </LinearLayout>
    <!--  Tabel  -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:orientation="vertical"
        android:paddingVertical="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <TextView
                style="@style/WaktuShalat.ScheduleHeaderCell"
                android:layout_width="40dp"
                android:layout_weight="0"
                android:gravity="start"
                android:text="@string/schedule_header_date" />

            <TextView
                style="@style/WaktuShalat.ScheduleHeaderCell"
                android:text="@string/prayer_fajr" />

            <TextView
                style="@style/WaktuShalat.ScheduleHeaderCell"
                android:text="@string/prayer_sunrise" />

            <TextView
                style="@style/WaktuShalat.ScheduleHeaderCell"
                android:text="@string/prayer_dhuhr" />

            <TextView
                style="@style/WaktuShalat.ScheduleHeaderCell"
                android:text="@string/prayer_asr" />

            <TextView
                style="@style/WaktuShalat.ScheduleHeaderCell"
                android:text="@string/prayer_maghrib" />

            <TextView
                style="@style/WaktuShalat.ScheduleHeaderCell"
                android:text="@string/prayer_isha" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutline" />
        <!--  Satu baris per tanggal. Scroll ke hari ini: layoutManager.scrollToPositionWithOffset(todayIndex, 0)
                     Garis antar baris (#EEF2F0): addItemDecoration(MaterialDividerItemDecoration(context, LinearLayoutManager.VERTICAL))  -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSchedule"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="20"
            tools:listitem="@layout/item_schedule_day" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/schedule_footnote"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />
</LinearLayout>